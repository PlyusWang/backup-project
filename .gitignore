# 最终 PDF 可以提交，因此不全局忽略 PDF。
# Test scratch data generated by scripts/test.sh
/testdata/
/build-*/

# 离线根私钥绝不允许进入仓库（PR #23）。私钥文件放在仓库之外的目录里，
# 权限 0600；下面几条只是防止手滑 cp 进来的最后一道防线。
offline-roots/
official-root-*.key
*.root-key

# 发布打包输出（scripts/stage-*-release.sh 生成），不进仓库。
/dist/

# 打包工具缓存（默认在 dist/ 下，这里兜底）
/packaging/.tools/
